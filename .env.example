# Public Next.js configuration for the shareable Robinhood Chain testnet demo.
NEXT_PUBLIC_SKOCCC_TARGET_CHAIN_ID=46630
NEXT_PUBLIC_BASKET_FACTORY_ADDRESS_46630=0x2b6Ac0B43Cf0e4c193b3BBdeca82bfBAac9ed891
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Required to persist optional app metadata. The Supabase anon key is designed
# for browser use and must be protected with Supabase Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only optional configuration. Do not prefix this with NEXT_PUBLIC_.
# Set it in Vercel only if server-side Supabase administration is enabled.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key

# Server-only testnet registry used by /api/stock-tokens. Replace these sample
# entries with the four mock-token entries produced by the local testnet deploy
# script. Mock token addresses are public, but this value must be valid JSON.
ROBINHOOD_TESTNET_MOCK_STOCK_TOKENS=[{"id":"testnet-mock-aapl","symbol":"AAPL","name":"Mock Apple Stock Token","contractAddress":"0x0000000000000000000000000000000000000001","chainId":46630,"currentMultiplier":"1","status":"ASSET_STATUS_ACTIVE"}]

# Optional server-side override. Leave unset to use the official Robinhood API.
ROBINHOOD_STOCK_TOKEN_API_BASE=https://api.robinhood.com/rhj

# Local Hardhat scripts only. Do not add any private key to Vercel.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# DEPLOYER_ADDRESS=0xYourPublicDeployerAddress
# DEPLOYER_PRIVATE_KEY=never-commit-or-upload-this-value
# ROBINHOOD_MAINNET_RPC_URL=https://your-private-mainnet-rpc.example
